## 📦 빌드 최적화

### **Vite 빌드 설정**
```typescript
// vite.config.ts
import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'

export default defineConfig({
  plugins: [react()],
  build: {
    target: 'es2015',  // ES6 타겟
    minify: 'esbuild',  // 빠른 빌드를 위한 esbuild 사용
    sourcemap: false,
    rollupOptions: {
      output: {
        manualChunks: {
          // 코드 스플리팅 설정
          vendor: ['react', 'react-dom'],
          router: ['react-router-dom'],
        },
      },
    },
  },
})
```

