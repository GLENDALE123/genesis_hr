rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 공개 읽기 전용 컬렉션 (예: 공지사항)
    match /public/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 사용자 프로필 - 보안 규칙 적용
    match /users/{userId} {
      // 읽기: 본인만 가능
      allow read: if request.auth != null && request.auth.uid == userId;
      // 쓰기: 본인만 가능
      allow write: if request.auth != null && request.auth.uid == userId;
      // 생성: 회원가입 시에만 허용
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    
    // 직원 데이터 (인증된 사용자만 읽기, 관리자만 쓰기)
    match /employees/{employeeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // 급여 데이터 (관리자만 접근 가능)
    match /payroll/{payrollId} {
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // 생산일보 데이터 (인증된 사용자만 접근 가능)
    match /production-reports/{reportId} {
      allow read, write: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // 엑셀 생산일보 데이터 (인증된 사용자만 접근 가능)
    match /excel-production-reports/{reportId} {
      allow read, write: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // 패키징 보고서 데이터 (HS-Jig와 동일한 컬렉션)
    match /packaging-reports/{reportId} {
      allow read, write: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // HS-Jig와 동일한 범용 규칙 (개발 편의를 위해)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
