rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 품질 검사 이미지 (인증된 사용자만 읽기, 업로드자만 쓰기)
    match /quality-inspections/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // 사용자별 폴더 (본인만 접근 가능)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 직원 프로필 이미지 (인증된 사용자만 읽기, 관리자만 쓰기)
    // 주의: Storage 규칙은 환경변수를 직접 사용할 수 없으므로 하드코딩 필요
    // 데이터베이스 ID를 변경하려면 이 파일을 수정하고 재배포해야 함
    // 현재 설정: tms-production 데이터베이스 참조
    match /employees/{employeeId}/profile.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        exists(/databases/tms-production/documents/users/$(request.auth.uid)) &&
        get(/databases/tms-production/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // 공개 파일 (모든 사용자 읽기 가능)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 기타 파일들 (인증된 사용자만)
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
