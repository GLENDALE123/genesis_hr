rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 품질 검사 이미지 (인증된 사용자만 읽기, 업로드자만 쓰기)
    match /quality-inspections/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // 사용자별 폴더 (본인만 접근 가능)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 직원 프로필 이미지 (인증된 사용자만 읽기, 인증된 사용자만 쓰기)
    // 주의: Storage 규칙에서는 Firestore 데이터에 직접 접근할 수 없습니다.
    // 관리자 권한 체크가 필요하다면 Cloud Functions를 통해 처리하거나
    // Firebase Auth의 Custom Claims를 사용해야 합니다.
    match /employees/{employeeId}/profile.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // 공개 파일 (모든 사용자 읽기 가능)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Electron 릴리스 파일 (모든 사용자 읽기 가능, 인증된 사용자만 쓰기)
    // 주의: Storage 규칙에서는 Firestore 데이터에 직접 접근할 수 없습니다.
    // 관리자 권한 체크가 필요하다면 Cloud Functions를 통해 처리하거나
    // Firebase Auth의 Custom Claims를 사용해야 합니다.
    match /electron-releases/{allPaths=**} {
      allow read: if true; // 공개 읽기 (설치 파일 다운로드용)
      allow write: if request.auth != null;
    }
    
    // 모바일 릴리스 파일 (모든 사용자 읽기 가능, 인증된 사용자만 쓰기)
    match /mobile-releases/{allPaths=**} {
      allow read: if true; // 공개 읽기 (APK 다운로드용)
      allow write: if request.auth != null;
    }
    
    // 기타 파일들 (인증된 사용자만)
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
