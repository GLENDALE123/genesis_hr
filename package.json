{
  "name": "hs-next",
  "version": "0.2.0",
  "private": true,
  "main": "electron/main.js",
  "description": "TMS 통합관리시스템",
  "author": "HS-HR",
  "repository": {
    "type": "git",
    "url": "https://github.com/mir1102/HS-Jig.git"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "dev:external": "next dev --turbo -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "start:external": "next start -H 0.0.0.0 -p 3000",
    "electron:dev": "concurrently \"cross-env NODE_ENV=development next dev --turbo\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "cross-env ELECTRON_BUILD=true CSC_IDENTITY_AUTO_DISCOVERY=false next build && electron-builder && npm run installer:build",
    "build:electron": "cross-env ELECTRON_BUILD=true CSC_IDENTITY_AUTO_DISCOVERY=false next build && electron-builder && npm run installer:build",
    "electron:build:win7": "cross-env ELECTRON_BUILD=true next build && electron-builder --win --x64 && npm run installer:build",
    "installer:build": "powershell -Command \"$makensis = (Get-Command makensis -ErrorAction SilentlyContinue).Source; if (!$makensis) { $makensis = 'C:\\Program Files (x86)\\NSIS\\makensis.exe' }; if (Test-Path $makensis) { & $makensis build\\installer.nsi } else { Write-Error 'NSIS not found. Please install NSIS or add it to PATH.' }\"",
    "lint": "eslint",
    "format": "prettier --write .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron-region-screenshot": "^2.0.1",
    "electron-updater": "^6.6.2",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.3.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-day-picker": "^9.11.0",
    "react-dom": "19.1.0",
    "react-easy-crop": "^5.5.3",
    "react-hook-form": "^7.64.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "use-debounce": "^10.0.6",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.1",
    "@types/node": "^20",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "storybook": "^9.1.10",
    "tailwindcss": "3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "ts-morph": "^27.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.hs.hr",
    "productName": "TMS 통합관리시스템",
    "asarUnpack": [
      "*.exe",
      "node_modules/electron-region-screenshot/**/*",
      "electron/notification.html",
      "electron/notification-preload.js",
      "electron/notification-window.js"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-out/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/tms-logo.png",
      "sign": false,
      "signingHashAlgorithms": []
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "TMS 통합관리시스템 Setup ${version}.${ext}"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "mir1102",
      "repo": "HS-Jig"
    }
  }
}
